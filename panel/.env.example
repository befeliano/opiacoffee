# Adisyon — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyala ve doldur. Vercel'de aynı adlarla
# Project Settings › Environment Variables altına gir.
#
# Supabase anahtarları boş bırakılırsa uygulama yerleşik veritabanıyla
# (PGlite, internetsiz) çalışır — dizüstünde demo ve geliştirme için.

# Supabase: Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Gizli anahtar (sb_secret_…): yalnızca sunucuda; ekip hesabı açmak ve
# kurulum betiği (npm run setup) için gerekir. Kimseyle paylaşma.
SUPABASE_SECRET_KEY=

# Uygulama adı (sekme başlığı, ana ekran simgesi). Boşsa "Adisyon".
NEXT_PUBLIC_APP_NAME=

# Demo modu: 1 → giriş ekranında "Demo olarak dene" düğmeleri, menüde
# "Test" rozeti ve Ayarlar › Test verisi paneli. Gerçek kafede boş bırak.
NEXT_PUBLIC_DEMO_MODE=

# Veri kaynağını zorla: local | supabase (genelde boş bırakılır)
DATA_BACKEND=
