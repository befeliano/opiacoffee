# Opia Coffee Co.: Apache yapılandırması (paylaşımlı hosting için)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS'e zorla (alan adı kurulduktan sonra aç)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www -> kök alan adı
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # QR kısa bağlantısı: /m/TOKEN -> masa/index.php
  RewriteRule ^m/([A-Za-z0-9]{6,32})/?$ masa/index.php?k=$1 [L,QSA]
  # index.html / index.php'yi URL'den temizle
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(html|php)[\s?] [NC]
  RewriteRule ^(.*/)?index\.(html|php)$ /$1 [R=301,L,NE]
</IfModule>

# Gizli klasörler
RedirectMatch 404 ^/(_src|_private)(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml application/ld+json
</IfModule>

# Önbellek
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
